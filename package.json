{
  "name": "@terrahop/eslint-config-svelte",
  "version": "1.3.0",
  "author": "@terrahop",
  "description": "Eslint configuration for svelte projects with typescript",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "changelog-template.hbs",
    "commitLimit": false
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.0.0-beta.4",
    "eslint": "9.29.0",
    "eslint-config-love": "114.0.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-jsdoc": "51.0.3",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "^3.0.3",
    "eslint-plugin-svelte": "3.9.2",
    "eslint-plugin-unicorn": "59.0.1",
    "globals": "^16.2.0",
    "svelte": "5.34.5",
    "svelte-eslint-parser": "1.2.0"
  },
  "devDependencies": {
    "auto-changelog": "2.5.0"
  }
}
